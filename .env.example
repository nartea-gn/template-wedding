VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# La pareja. Todas opcionales: sin ellas se renderizan los nombres de la plantilla.
VITE_PARTNER_ONE=Gala
VITE_PARTNER_TWO=Valentin

# Los apellidos son opcionales de verdad: si no vienen, no se escribe nada en su lugar
# (`gifts.account.holder` pasa a leer «Gala y Valentin»).
VITE_SURNAME_ONE=
VITE_SURNAME_TWO=

# Solo para los idiomas que transliteran los nombres. Si falta el override, se usa el valor base.
VITE_PARTNER_ONE_BG=Гала
VITE_PARTNER_TWO_BG=Валентин
VITE_SURNAME_ONE_BG=
VITE_SURNAME_TWO_BG=
