SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=replace-with-the-local-secret-key
NARTEA_INVITATION_ID=gala-y-valentin
NARTEA_ADMIN_AUTH_METHOD=otp
NARTEA_ADMIN_EMAILS=admin-one@example.test,admin-two@example.test

# Required only with --production. It must exactly match NARTEA_INVITATION_ID.
NARTEA_PROVISION_CONFIRM=

# Set to NARTEA_INVITATION_ID only to add an administrator to a wedding that is already
# provisioned. Without it, finding administrators this run did not ask for fails the command:
# it usually means the slug already belongs to a different wedding.
NARTEA_PROVISION_ALLOW_EXISTING=
